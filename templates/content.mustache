{{!
    @template block_dynamicuseradvancement/content

    Card-based training advancement with status badges, tuned for a narrow side column.

    Context variables required for this template:
    * empty - True when no milestone is configured.
    * heading - Block heading.
    * iscomplete - True when all milestones are done.
    * percent - Overall percentage (0-100) for the header ring.
    * statustitle, statussub - Human status message.
    * cards - Milestone cards: label, detail, isaccess/isgrade/iscert,
      isdone/iscurrent/istodo, badgelabel, url, hasurl.
    * gonow - Label of the call-to-action button.
    * certobtained - Label for the completed state.
    * showexpiry, updatedue, updatevalid - Expiry information.

    Example context (json):
    {
        "empty": false,
        "iscomplete": false,
        "percent": 33,
        "statustitle": "Ciao Daniele",
        "statussub": "1 di 3 traguardi · sei a buon punto",
        "gonow": "Vai",
        "certobtained": "Attestato conseguito",
        "showexpiry": false,
        "cards": [
            {"label": "Accesso al corso", "detail": "04/07/2026",
             "isaccess": true, "isgrade": false, "iscert": false,
             "isdone": true, "iscurrent": false, "istodo": false,
             "badgelabel": "Completato", "url": "", "hasurl": false},
            {"label": "Verifica finale", "detail": "Voto: da sostenere",
             "isaccess": false, "isgrade": true, "iscert": false,
             "isdone": false, "iscurrent": true, "istodo": false,
             "badgelabel": "In corso", "url": "https://x", "hasurl": true}
        ]
    }
}}
<div class="block_dynamicuseradvancement {{#iscomplete}}dua-complete{{/iscomplete}}">

    {{#empty}}
        <p class="dua-empty">{{#str}}notconfigured, block_dynamicuseradvancement{{/str}}</p>
    {{/empty}}

    {{^empty}}
    <div class="dua-head">
        <svg class="dua-ring" width="46" height="46" viewBox="0 0 46 46" aria-hidden="true">
            <circle class="dua-ring-bg" cx="23" cy="23" r="18" fill="none" stroke-width="5"/>
            <circle class="dua-ring-fg" cx="23" cy="23" r="18" fill="none" stroke-width="5"
                    stroke-linecap="round" pathLength="100" stroke-dasharray="{{percent}} 100"
                    transform="rotate(-90 23 23)"/>
            <text class="dua-ring-text" x="23" y="27" text-anchor="middle">{{percent}}%</text>
        </svg>
        <div class="dua-head-text">
            <div class="dua-title">{{statustitle}}</div>
            <div class="dua-sub">{{statussub}}</div>
        </div>
    </div>

    {{#iscomplete}}
    <div class="dua-medal">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="6"/><path d="M8.2 13.9L7 22l5-3 5 3-1.2-8.1"/>
        </svg>
        <span>{{certobtained}}{{#showexpiry}} · {{updatevalid}}{{/showexpiry}}</span>
    </div>
    {{/iscomplete}}

    <div class="dua-cards">
        {{#cards}}
        <div class="dua-card {{#isdone}}dua-done{{/isdone}}{{#iscurrent}}dua-current{{/iscurrent}}{{#istodo}}dua-todo{{/istodo}}">
            <div class="dua-card-row">
                <span class="dua-icon" aria-hidden="true">
                    {{#isaccess}}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>{{/isaccess}}
                    {{#isgrade}}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg>{{/isgrade}}
                    {{#iscert}}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M8.2 13.9L7 22l5-3 5 3-1.2-8.1"/></svg>{{/iscert}}
                </span>
                <div class="dua-card-body">
                    <div class="dua-card-label">{{label}}</div>
                    <div class="dua-card-detail">{{detail}}</div>
                </div>
                <span class="dua-badge">{{badgelabel}}</span>
            </div>
            {{#hasurl}}<a class="dua-btn" href="{{url}}">{{gonow}}</a>{{/hasurl}}
        </div>
        {{/cards}}
    </div>

    {{#showexpiry}}
    {{^iscomplete}}
    <div class="dua-banner">
        <div class="dua-banner-title">{{updatedue}}</div>
        <div class="dua-banner-sub">{{updatevalid}}</div>
    </div>
    {{/iscomplete}}
    {{/showexpiry}}
    {{/empty}}

</div>
